# Copia este archivo a .env.local y llena los valores.
# Supabase > Project Settings > API Keys (publishable) y Data API (URL)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública del sitio, sin "/" al final.
# Local: http://localhost:3000 · Producción (Cloudflare): https://sheday.mx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Llave SECRETA (solo servidor, NUNCA con prefijo NEXT_PUBLIC_).
# Supabase > Project Settings > API Keys > Secret keys. En Cloudflare va como *Secret* de runtime.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# ---------- Códigos por WhatsApp (solo servidor; en Cloudflare van como *Secret*) ----------
# Supabase > Authentication > Auth Hooks > Send SMS (HTTPS) > secreto generado ("v1,whsec_...")
SEND_SMS_HOOK_SECRET=v1,whsec_xxxxxxxxxxxxxxxx
# Meta > token permanente del usuario del sistema (permisos whatsapp_business_messaging y _management)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx
# Meta > WhatsApp > Configuración de la API > Phone Number ID del remitente
WHATSAPP_PHONE_NUMBER_ID=000000000000000
# Opcionales (estos son los valores por defecto)
# WHATSAPP_TEMPLATE=sheday_codigo
# WHATSAPP_TEMPLATE_LANG=es_MX
# WHATSAPP_API_VERSION=v23.0

# ---------- Cloudflare Turnstile (anti-bots en registro, login y códigos) ----------
# Llave PÚBLICA del sitio (se incrusta al compilar; en Cloudflare va como variable de *build*).
# Vacía = desactivado. El secreto NO va aquí: va en Supabase > Authentication > Attack Protection.
# Llave de prueba que siempre pasa: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
