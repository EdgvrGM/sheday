{
  "expo": {
    "name": "Sheday",
    "slug": "sheday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sheday",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.sheday.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.sheday.app",
      "adaptiveIcon": {
        "backgroundColor": "#FCE4EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCE4EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sheday usa tus fotos para subir imágenes de productos.",
          "cameraPermission": "Sheday usa la cámara para fotografiar productos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
